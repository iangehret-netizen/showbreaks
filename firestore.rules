rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the hidden passcode account can read or write.
    // (Its email is set by syncEmail in firebase-config.js; default sync@weighbreaks.app)
    function allowed() {
      return request.auth != null
        && request.auth.token.email == 'sync@weighbreaks.app';
    }

    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
